{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhaseMiX",
  "version": "3.7.2",
  "identifier": "com.kuberbassi.phasemix",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "PhaseMiX",
        "theme": "Dark",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#0f1014"
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
